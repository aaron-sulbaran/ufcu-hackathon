# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: model override. Default is claude-haiku-4-5-20251001 for speed; use claude-sonnet-5 for quality.
FRONT_DESK_MODEL=claude-haiku-4-5-20251001
# Set to "1" to force the offline scripted persona responses (demo fallback, no API calls).
FRONT_DESK_OFFLINE=0
